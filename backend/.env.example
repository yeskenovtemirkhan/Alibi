# local | test | staging | production
APP_ENV=local
# SQLAlchemy URL (psycopg 3 driver). Matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg://alibi:alibi@localhost:5433/alibi
# Comma-separated list of allowed browser origins (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000
# Used by pytest. Tests migrate and truncate this database — never point it at real data.
TEST_DATABASE_URL=postgresql+psycopg://alibi:alibi@localhost:5433/alibi_test
